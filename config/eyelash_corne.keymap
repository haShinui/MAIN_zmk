#include <behaviors.dtsi>
#include <behaviors/unicode.dtsi> // for zmk-unicode

/* ----- For default ZMK behavior ---- */
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>

/* ----- Extra zmk modules ---- */
#include <zmk-unicode/keys-extra.h>
#include "zmk-helpers/helper.h"
#include <input/processors.dtsi>
#include "zmk-helpers/german.dtsi"
#include "german.dtsi"


/* Mouse input processing default values*/
#undef ZMK_MOUSE_DEFAULT_MOVE_VAL
#undef ZMK_MOUSE_DEFAULT_SCRL_VAL
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1000  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20   // 10

#define ZMK_POINTING_DEFAULT_MOVE_VAL 3500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 400    // default: 10
 

&mmv {
  acceleration-exponent = <1>;      // 1
  time-to-max-speed-ms = <400>;     // 300
  delay-ms = <0>;                   // 0
};

&msc {
  acceleration-exponent = <1>;      // 0
  time-to-max-speed-ms = <50>;     // 300
  delay-ms = <0>;                   // 0
};

 &uc {
  default-mode = <UC_MODE_WIN_COMPOSE>;
  minimum-length = <0>; 
}; 

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        Tab_switching: Tab_switching {
            compatible = "zmk,behavior-sensor-rotate";
            label = "TAB_SWITCHING";
            #sensor-binding-cells = <0>;
            bindings = <&kp LC(LA(TAB))>, <&kp LC(LA(LS(TAB)))>;   
        };

        App_switching: App_switching {
            compatible = "zmk,behavior-sensor-rotate";
            label = "APP_SWITCHING";
            #sensor-binding-cells = <0>;
            bindings = <&kp LG(TAB)>, <&kp LG(LS(TAB))>;
        };

        tap_layer: tap_layer {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_LAYER";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&kp CAPSLOCK>;
        };

        next_previous: next_previous {
            compatible = "zmk,behavior-tap-dance";
            label = "NEXT_PREVIOUS";
            #binding-cells = <0>;
            bindings = <&kp C_NEXT>, <&kp C_PREVIOUS>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };


        scroll_encoder: scroll_encoder {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
			tap-ms = <65>;
		};

        op: op {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&uc>, <&uc>;
            display-name = "Mod-Tap";
        };
 

    
        
    };

    

    combos { compatible = "zmk,combos"; 

        esc_q_combo: esc_q_combo {
            timeout-ms = <50>;
            key-positions = <0 1>; // positions of the keys in the matrix
            bindings = <&kp ESC>;  // what combo sends
            layers = <0 4>;
        };

    };

    macros {
        bt1: bt1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>;
            label = "BT1";
        };
        ae: ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc UC_DE_AE>;
            label = "ae";
        };
        ue: ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc UC_DE_UE>;
            label = "ue";
        };
        win: win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc UC_SET_WIN_COMPOSE>;
            label = "win";
        };
        lin: lin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&uc UC_SET_LINUX>;
            label = "lin";
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp BACKSPACE  &kp Q            &kp W            &kp F              &kp P              &kp B                                 &kp UP_ARROW              &kp J        &kp L               &kp U           &kp Y             &kp SEMI          &kp DELETE
&key_repeat    &hmr LEFT_WIN A  &hmr LEFT_ALT R  &hmr LEFT_SHIFT S  &hmr LCTRL T       &kp G                       &kp LEFT  &sk LGUI     &kp RIGHT    &kp M        &hmr RIGHT_SHIFT N  &hmr RCTRL E    &hmr RIGHT_ALT I  &hmr RIGHT_WIN O  &kp SQT
&tap_layer     &kp Z            &kp X            &kp C              &kp D              &kp V      &kp C_PLAY_PAUSE           &kp DOWN                  &kp K        &kp H               &kp COMMA       &kp DOT           &kp FSLH          &mo 3
                                                 &kp LGUI           &kp SPACE          &lt 1 TAB                                                       &lt 2 ENTER  &kp BACKSPACE       &sk LEFT_SHIFT
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        lower_layer {
            display-name = "FUNCTIONS";
            bindings = <
&kp ESC        &mt LG(LS(N1)) LG(NUMBER_1)  &mt LG(LS(N2)) LG(NUMBER_2)  &mt LG(LS(N3)) LG(NUMBER_3)  &mt LG(LS(N4)) LG(NUMBER_4)  &mt LG(LS(N5)) LG(N5)                                     &mmv MOVE_UP                     &bt BT_CLR    &bt BT_SEL 0      &deue 1 0          &bt BT_SEL 2        &bt BT_SEL 3   &win_lin 0 1
&kp LC(F)      &deae 1 LC(X)                &mt LC(LS(C)) LC(C)          &mt LC(LS(V)) LC(V)          &kp LC(Z)                    &kp LC(Y)                                 &mmv MOVE_LEFT  &mkp LCLK    &mmv MOVE_RIGHT     &kp K_MUTE    &kp C_PLAY_PAUSE  &next_previous     &trans              &uc UC_DE_OE   &trans
&kp C_AC_CLOSE &kp C_AC_REFRESH             &kp LC(K)                    &kp C_AC_ZOOM_IN             &kp C_AC_ZOOM_OUT            &kp HOME               &kp C_PLAY_PAUSE                   &mmv MOVE_DOWN                   &kp HOME      &kp PSCRN         &trans             &trans              &trans         &trans
                                                                         &trans                       &trans                       &trans                                                                                     &kp LEFT_GUI  &kp BACKSPACE     &sk LEFT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "SYMBOLS";
            bindings = <
&kp GRAVE  &kp NUMBER_1  &kp NUMBER_2          &kp NUMBER_3           &kp NUMBER_4  &kp N5                                           &msc SCRL_UP                     &kp NUMBER_6  &kp N7          &kp N8        &kp N9         &kp N0     &kp BSPC
&kp MINUS  &kp EQUAL     &kp LBKT              &kp RBKT               &kp BSLH      &kp APOS                        &msc SCRL_LEFT   &kp LG(F)     &msc SCRL_RIGHT    &kp LC(LEFT)  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN       &kp RIGHT  &kp LC(RIGHT)
&kp COMMA  &kp DOT       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp FSLH      &sk LEFT_ALT    &kp LG(TAB)                      &msc SCRL_DOWN                   &sl 3         &kp HOME        &kp PSCRN     &trans         &kp END    &kp ENTER
                                               &sk LCTRL              &sk LEFT_GUI  &sk LEFT_SHIFT                                                                    &trans        &trans          &trans
            >;

            sensor-bindings = <&Tab_switching>;
        };

        Fn_layer {
            display-name = "FN";
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                     &trans          &kp F6      &kp F7            &kp F8          &kp F9  &kp F10  &kp F11
&trans   &trans  &trans  &trans  &trans  &trans                             &trans  &trans  &trans  &kp C_MUTE  &kp C_PLAY_PAUSE  &next_previous  &trans  &trans   &tog 4
&trans   &trans  &trans  &trans  &trans  &trans  &mt C_NEXT C_PLAY_PAUSE            &trans          &trans      &trans            &trans          &trans  &trans   &trans
                         &trans  &trans  &trans                                                     &trans      &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        QWERTY {
            display-name = "QWERTY";
            bindings = <
&mo 2      &kp Q            &kp W             &kp E                &kp R                &kp T                                         &kp UP_ARROW                     &kp Y              &kp U                &kp I                &kp O              &kp P                 &kp BSPC
&kp TAB    &hmr LEFT_WIN A  &hmr LEFT_ALT S   &hmr LEFT_SHIFT D    &hmr LCTRL F         &kp G                         &kp LEFT_ARROW  &kp ENTER       &kp RIGHT_ARROW  &kp H              &hmr RCTRL J         &hmr RIGHT_SHIFT K   &hmr RIGHT_ALT L   &hmr RIGHT_WIN SEMICOLON   &kp FSLH
&kp LSHFT  &kp Z            &kp X             &kp C                &kp V                &kp B     &kp C_PLAY_PAUSE                    &kp DOWN_ARROW                   &kp N              &kp M                &kp COMMA            &kp DOT            &kp FSLH              &tog 4
                                              &kp LGUI             &kp SPACE            &kp LCTRL                                                                      &kp ENTER          &kp SPACE            &kp LALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };
    };
};
