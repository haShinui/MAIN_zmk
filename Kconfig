DT_COMPAT_ZMK_CYCLOTAB := zmk,cyclotab
DT_COMPAT_ZMK_BEHAVIOR_CYCLOTAB_LAYER := zmk,behavior-cyclotab-layer
DT_COMPAT_ZMK_BEHAVIOR_CYCLOTAB_REVERSE := zmk,behavior-cyclotab-reverse

config ZMK_CYCLOTAB
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_CYCLOTAB)) || $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_CYCLOTAB_LAYER)) || $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_CYCLOTAB_REVERSE))
